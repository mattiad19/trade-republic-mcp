{
  "name": "trade-republic-mcp-readonly",
  "version": "1.0.0",
  "private": true,
  "description": "Local read-only MCP server for an unofficial Trade Republic API",
  "type": "module",
  "bin": {
    "trade-republic-mcp": "dist/src/server.js",
    "trade-republic-auth": "dist/src/cli.js"
  },
  "scripts": {
    "build:keychain": "mkdir -p bin && xcrun swiftc native/KeychainHelper.swift -o bin/tr-keychain-helper",
    "build": "npm run build:keychain && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run audit",
    "auth": "node dist/cli.js auth"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "tough-cookie": "6.0.2",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
